unbind C-b
set -g prefix C-g
bind C-g send-prefix

# TPM (Tmux Plugin Manager) configuration
set-environment -g TMUX_PLUGIN_MANAGER_PATH '~/.tmux/plugins/'

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'jaclu/tmux-menus'
set -g @plugin 'schasse/tmux-jump'
set -g @plugin 'b0o/tmux-autoreload'
set -g @plugin 'tmux-plugins/tmux-open'
set -g @plugin 'laktak/extrakto'
set -g @plugin 'tmux-plugins/tmux-cpu'

# Auto-restore disabled - use manual restore (Prefix + C-r) instead
set -g @continuum-restore 'off'
set -g @continuum-save-interval '15'

# Manual restore: Prefix + C-r (C-g C-r with our custom prefix)
bind C-r run-shell ~/.tmux/plugins/tmux-resurrect/scripts/restore.sh

set -g @menus_trigger 'm'
set -g @jump-key '/'

bind \\ split-window -h -c "~/Documents"
bind - split-window -v -c "~/Documents"

# ----------------------------------------------------------------------------
# Floating panes (tmux 3.7, 2026-06)
# ----------------------------------------------------------------------------
# A floating pane hovers above the tiled layout instead of taking space from it.
# Unlike display-popup it is NOT modal: it is a real pane, so it accepts escape
# sequences, keeps running when focus moves elsewhere, and shows up in list-panes.
# `new-pane` always creates one - that is the command's whole purpose - and tmux
# 3.7 already binds it bare to `prefix *` (a small pane at a cascading offset).
#
# The binding below adds a centred, generously sized scratch float. Note there is
# no -X C / -Y C centring shorthand on new-pane (that is display-popup syntax and
# new-pane rejects it with "size or position invalid"), so the offset is computed:
# a pane sized N% needs a margin of (100 - N) / 2 percent on each side. With
# N = 70 that is 15, which is the 15 in both expressions. Change one, change both.
#
# Bound to F (Float), deliberately NOT g. With prefix C-g, tmux-sensible binds
# `prefix g` to last-window ("prefix without ctrl"), and it guards that with
# key_binding_not_set. Since tpm loads at the bottom of this file, a `bind g` up
# here wins the race and silently costs us C-g g for window switching.
bind F new-pane -x 70% -y 70% \
  -X '#{e|/:#{e|*:#{window_width},15},100}' \
  -Y '#{e|/:#{e|*:#{window_height},15},100}' \
  -c "#{pane_current_path}"
#
# Caveat in 3.7: a floating pane can only be MOVED and RESIZED with the mouse.

# Line numbers in copy mode (tmux 3.7). `hybrid` shows the cursor line as an
# absolute number and every other line relative to it, which is what makes
# vi-style counts (12k, 5j) usable while scrolling back.
set -g copy-mode-line-numbers hybrid

# Not enabled: `focus-follows-mouse on` (also 3.7). It changes pane focus on mere
# hover, which fights the explicit prefix+hjkl navigation configured below.

set -g display-panes-time 2000
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"

setw -g mode-keys vi
bind-key -T copy-mode-vi 'v' send -X begin-selection
bind-key -T copy-mode-vi 'C-v' send -X rectangle-toggle
bind-key -T copy-mode-vi 'y' send -X copy-selection

set -s escape-time 0
set-option -g history-limit 2000
set-option -g base-index 1
set-option -g mouse on  

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

bind -r C-h resize-pane -L 10
bind -r C-l resize-pane -R 10
bind -r C-j resize-pane -D 10
bind -r C-k resize-pane -U 10

# ============================================================================
# Status Bar Configuration
# ============================================================================

# Status bar positioning and styling
set -g status-position bottom
set -g status-style 'bg=green,fg=black'
set -g status-interval 15

# Left side: session name
set -g status-left-length 20
set -g status-left '#[bg=green,fg=black,bold] [#{session_name}] '

# Right side: system info + date/time
set -g status-right-length 120
{{- if eq .chezmoi.os "darwin" }}
set -g status-right '#[bg=green,fg=black]#(~/.local/bin/tmux-claude-usage.sh 2>/dev/null || echo "") | CPU: #{cpu_percentage} | RAM: #{ram_percentage} | #(~/.local/bin/tmux-battery.sh 2>/dev/null || pmset -g batt | grep -Eo "[0-9]+%" | head -1) | %H:%M %d-%b-%y '
{{- else }}
# Codespaces/Linux: Simplified status (no battery, use built-in CPU/RAM plugins)
set -g status-right '#[bg=green,fg=black]CPU: #{cpu_percentage} | RAM: #{ram_percentage} | %H:%M %d-%b-%y '
{{- end }}

# Window status formatting
set -g window-status-format ' #I:#W#F '
set -g window-status-current-format '#[bg=green,fg=black,bold] #I:#W#F '
set -g window-status-separator ''

# ============================================================================
# Initialize TPM (Tmux Plugin Manager)
# ============================================================================
# Keep this line at the very bottom of tmux.conf
run '~/.tmux/plugins/tpm/tpm'
