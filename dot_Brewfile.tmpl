{{- if eq .chezmoi.os "darwin" }}
# macOS-only packages and casks
brew "trash"           # Move files to trash instead of rm (macOS only)
# macOS-only casks (GUI applications, fonts, etc.)
# alacritty removed: the cask is disabled on 2026-09-01 (fails_gatekeeper_check - the app is not
#   signed with an Apple certificate), and ghostty is now the daily driver. NOTE for the record:
#   alacritty upstream is NOT dead - v0.17.0 shipped 2026-04 and commits land weekly. Only the
#   Homebrew distribution channel is going away. Removed here because ghostty and kitty already
#   cover the job, not because the project ended. Removed alongside it, since they existed only
#   to serve it: dot_config/alacritty/ (config + themes), the toggle_opacity script, its PATH
#   entries in 04-env / zshrc-monolithic / dot_zshrc, and the Cmd+U Hammerspoon binding.
cask "kitty"           # GPU-accelerated terminal (secondary)
cask "ghostty"         # Fast, native, GPU-accelerated terminal (Zig-based). The primary terminal:
                       # dot_hammerspoon/init.lua binds Alt-Space to it and dot_config/ghostty/
                       # carries the full config. 1.3.0 shipped 2026-03 on a 6-month cadence.
cask "wezterm"         # Lua-configurable terminal with SSH integration. NOT unmaintained - the
                       # repo is busy (100+ commits in the last 180 days, 21 of them from wez
                       # himself) - but TAGGED RELEASES have stalled: the newest is still
                       # 20240203-110809 from 2024-02-03, which is what this stable cask installs.
                       # So this line pins a 2.5-year-old build of an actively developed program.
                       # For current builds the upstream macOS install page offers a second cask,
                       # `wezterm@nightly`. Nothing in this repo configures wezterm either way.
cask "orbstack"        # Fast, lightweight Docker Desktop alternative
cask "arc"             # In upstream maintenance mode since 2025-05: security and Chromium
                       # updates only, no new features. The Browser Company moved to Dia.
