{{- $apiKey := onepasswordRead (printf "op://%s/Claude Code API Key/credential" .onepassword.vault) -}}
# =============================================================================
# AI Profile: API Mode
# =============================================================================
# Auto-generated from 1Password by chezmoi

# Anthropic API Key
ANTHROPIC_API_KEY={{ $apiKey }}

# Profile identifier
AI_PROFILE=API

# CLAUDE_CONFIG_DIR: deliberately unset. Setting it, even to the default
# ~/.claude, makes claude keep its login in a hashed keychain entry
# ("Claude Code-credentials-<hash>"), so a claude started without it (Orca,
# launchd, GUI apps) reads the unhashed entry, a different and stale login.

# Optional: OpenAI-compatible router (e.g., LiteLLM)
# Uncomment if using a proxy/router
# OPENAI_BASE_URL=http://localhost:4000
# OPENAI_API_KEY=proxy-key
