# =============================================================================
# AI Profile: MAX Mode
# =============================================================================
# This profile uses Claude Max/Pro subscription (not API)
# API keys are explicitly unset to prevent accidental API charges

# Profile identifier
AI_PROFILE=MAX

# CLAUDE_CONFIG_DIR: deliberately unset. Setting it, even to the default
# ~/.claude, makes claude keep its login in a hashed keychain entry
# ("Claude Code-credentials-<hash>"), so a claude started without it (Orca,
# launchd, GUI apps) reads the unhashed entry, a different and stale login.

# Explicitly unset API keys to prevent accidental usage
# (These will be unset when this profile is active)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
