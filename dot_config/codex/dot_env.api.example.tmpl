# =============================================================================
# Codex Profile: API Mode (Example Template)
# =============================================================================
# This is a template file. The actual .env.api will be created by:
#   mise codex-init (fetches from 1Password)
# Or manually copy this file:
#   cp ~/.config/codex/.env.api.example ~/.config/codex/.env.api
#   (then edit and add your API key)

# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_API_KEY_HERE

# Profile identifier
CODEX_PROFILE=API

# Config directory. Both profiles share ~/.codex: that is where the real config
# lives (config.toml, MCP servers, auth, session history). The per-account dirs
# ~/.codex-personal / ~/.codex-work were never created, so pointing CODEX_HOME at
# them made codex start with an empty config. Profiles only toggle the API key,
# matching how CLAUDE_CONFIG_DIR is handled on the claude side.
CODEX_HOME={{ .chezmoi.homeDir }}/.codex
